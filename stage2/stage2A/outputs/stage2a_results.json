{
  "experiment_name": "stage2a_contrastive_reward_model",
  "config": {
    "experiment_name": "stage2a_contrastive_reward_model",
    "seed": 42,
    "model": {
      "base_model_name": "microsoft/codebert-base",
      "policy_model_name": "microsoft/CodeGPT-small-py",
      "embedding_dim": 768,
